{
  "name": "@readany/app-expo",
  "version": "1.3.5",
  "private": true,
  "main": "index.js",
  "expo": {
    "entryPoint": "./index.js",
    "install": {
      "exclude": ["react-native-keyboard-controller", "react-native-screens"]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["react-native-tcp-socket", "react-native-track-player"],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "./script/build_and_run.sh start-lan",
    "simulator": "./script/build_and_run.sh",
    "start:lan": "./script/build_and_run.sh start-lan",
    "rebuild:ios": "./script/build_and_run.sh rebuild-ios",
    "start:clear": "APP_VARIANT=development pnpm run build:reader && APP_VARIANT=development node scripts/configure-native-variant.js && EXPO_NO_METRO_LAZY=1 APP_VARIANT=development expo start --dev-client --scheme readany-dev --clear",
    "start:dev": "pnpm run start",
    "start:dev:clear": "pnpm run start:clear",
    "storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED=true APP_VARIANT=development node scripts/configure-native-variant.js && EXPO_NO_METRO_LAZY=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true APP_VARIANT=development expo start --dev-client --scheme readany-dev --clear",
    "storybook:reader": "EXPO_PUBLIC_STORYBOOK_ENABLED=true EXPO_PUBLIC_READER_STORYBOOK_ONLY=true APP_VARIANT=development node scripts/configure-native-variant.js && EXPO_NO_METRO_LAZY=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true EXPO_PUBLIC_READER_STORYBOOK_ONLY=true APP_VARIANT=development expo start --dev-client --scheme readany-dev --clear --lan",
    "storybook:ios": "EXPO_NO_METRO_LAZY=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true APP_VARIANT=development expo run:ios",
    "storybook:android": "EXPO_NO_METRO_LAZY=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true APP_VARIANT=development expo run:android",
    "preandroid": "pnpm run build:reader",
    "android": "EXPO_NO_METRO_LAZY=1 expo run:android",
    "android:dev": "APP_VARIANT=development pnpm run build:reader && EXPO_NO_METRO_LAZY=1 APP_VARIANT=development expo run:android --device",
    "preios": "pnpm run build:reader && node scripts/configure-native-variant.js",
    "ios": "EXPO_NO_METRO_LAZY=1 expo run:ios",
    "ios:dev": "APP_VARIANT=development pnpm run build:reader && APP_VARIANT=development node scripts/configure-native-variant.js && EXPO_NO_METRO_LAZY=1 APP_VARIANT=development expo run:ios --device",
    "ios:simulator": "pnpm run rebuild:ios",
    "preprebuild": "pnpm run build:reader",
    "prebuild": "expo prebuild",
    "build:reader": "node scripts/build-reader.js",
    "icons:mapping": "node scripts/generate-icon-mapping-page.mjs",
    "generate:icons": "node scripts/generate-app-icons.js",
    "generate:catalog-covers": "node scripts/generate-catalog-covers.mjs",
    "generate:catalog-character-portraits": "node --import tsx scripts/generate-catalog-character-portraits.ts",
    "clean:catalog-books": "node scripts/clean-catalog-books.mjs",
    "sync:catalog-covers:nano": "node scripts/sync-nano-banana-covers.mjs",
    "sync:storybook-covers:nano": "node scripts/sync-nano-storybook-covers.mjs",
    "sync:native-variant": "node scripts/configure-native-variant.js",
    "lint": "biome check .",
    "test": "vitest run src/lib/narra src/lib/book src/lib/reader src/lib/diagnostics src/lib/ai/narra-gateway-fetch.test.ts src/lib/ai/openrouter-chat.test.ts src/lib/ai/narra-chat.test.ts",
    "eas-build-pre-install": "bash scripts/eas-install-ios-build-tools.sh",
    "eas-build-post-install": "pnpm run build:reader && node scripts/configure-native-variant.js",
    "eas:device:create": "pnpm exec eas device:create",
    "eas:build:android": "APP_VARIANT=production pnpm exec eas build --profile production --platform android",
    "eas:build:android:dev": "APP_VARIANT=development pnpm exec eas build --profile development --platform android",
    "eas:build:android:preview": "APP_VARIANT=preview pnpm exec eas build --profile preview --platform android",
    "eas:build:ios": "APP_VARIANT=production pnpm exec eas build --profile production --platform ios",
    "eas:build:ios:dev": "APP_VARIANT=development pnpm exec eas build --profile development --platform ios",
    "eas:build:ios:simulator": "APP_VARIANT=development pnpm exec eas build --profile development-simulator --platform ios",
    "eas:build:ios:preview": "APP_VARIANT=preview pnpm exec eas build --profile preview --platform ios",
    "generate:panelui-theme": "node --import tsx scripts/generate-panelui-theme.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@deslop/primitives": "workspace:*",
    "@dr.pogodin/react-native-fs": "^2.38.2",
    "@dr.pogodin/react-native-static-server": "^0.26.2",
    "@expo/ui": "57.0.11",
    "@langchain/anthropic": "^1.3.21",
    "@langchain/core": "^1.1.29",
    "@langchain/deepseek": "^1.0.15",
    "@langchain/google-genai": "^2.1.21",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/openai": "^1.2.11",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/elements": "2.9.36",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@readany/core": "workspace:*",
    "@zip.js/zip.js": "^2.7.52",
    "base64-js": "1.5.1",
    "expo": "~57.0.14",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-battery": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "57.0.12",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "i18next": "^25.8.13",
    "pako": "^2.1.0",
    "panelui-native": "^0.78.0",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-devtools-core": "^7.0.1",
    "react-i18next": "^16.5.4",
    "react-native": "~0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "~15.15.4",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-track-player": "^4.1.2",
    "react-native-view-shot": "^5.1.0",
    "react-native-webview": "~13.16.1",
    "react-native-worklets": "0.10.1",
    "sonner-native": "0.27.0",
    "tailwindcss": "^4.3.3",
    "text-encoding": "^0.7.0",
    "uniwind": "^1.11.0",
    "whatwg-fetch": "^3.6.20",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@storybook/addon-ondevice-actions": "10.4.2",
    "@storybook/addon-ondevice-backgrounds": "10.4.2",
    "@storybook/addon-ondevice-controls": "10.4.2",
    "@storybook/react": "10.4.2",
    "@storybook/react-native": "10.4.2",
    "@storybook/react-native-ui": "10.4.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.17",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-import-meta": "^2.3.2",
    "babel-preset-expo": "57.0.6",
    "eas-cli": "^18.11.0",
    "esbuild": "^0.27.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "storybook": "10.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
